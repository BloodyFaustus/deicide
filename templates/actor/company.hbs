<section class="company-sheet">
  <header class="sheet-header">
    <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
    <div class="identity">
      <input type="text" name="name" value="{{actor.name}}">
      <p class="line">{{#if doctrineIcon}}<i class="fa-solid {{doctrineIcon}} doctrine-icon" data-tooltip="{{doctrineLabel}}"></i> {{/if}}{{localize derived.typeLabel}}{{#if system.shipClass}} ({{system.shipClass}}){{/if}}, {{localize "DEICIDE.Common.Quality"}} {{system.quality}} ({{derived.qualityGrade}}){{#if system.named}}, {{localize "DEICIDE.Company.Named"}}{{/if}}{{#if system.routed}}, {{localize "DEICIDE.Company.Routed"}}{{/if}}</p>
    </div>
  </header>
  <div class="strength-bar" data-tooltip="{{localize 'DEICIDE.Common.Strength'}}">
    <span class="fill" style="width: {{system.strength}}%"></span>
    <span class="text">{{localize "DEICIDE.Common.Strength"}} {{system.strength}}</span>
  </div>
  <div class="grid two">
    <label>{{localize "DEICIDE.Common.Strength"}} <input type="number" name="system.strength" value="{{system.strength}}" min="0" max="100"></label>
    <label>{{localize "DEICIDE.Common.Quality"}} <input type="number" name="system.quality" value="{{system.quality}}" min="1" max="5"> <small>{{localize "DEICIDE.Company.Cap" cap=qualityCap}}</small></label>
    <label>{{localize "DEICIDE.Common.Type"}} <select name="system.type">{{#each types}}<option value="{{id}}" {{#if (eq id @root.system.type)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize "DEICIDE.Company.ShipClass"}} <select name="system.shipClass"><option value="">{{localize "DEICIDE.Common.None"}}</option>{{#each ships}}<option value="{{this}}" {{#if (eq this @root.system.shipClass)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label>{{localize "DEICIDE.Common.Side"}} <select name="system.side">{{#each sides}}<option value="{{this}}" {{#if (eq this @root.system.side)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    <label>{{localize "DEICIDE.Common.Doctrine"}} <select name="system.doctrine"><option value="">{{localize "DEICIDE.Company.PlayerRun"}}</option>{{#each doctrines}}<option value="{{id}}" {{#if (eq id @root.system.doctrine)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
    <label>{{localize "DEICIDE.Common.Owner"}} <select name="system.owner"><option value="">{{localize "DEICIDE.Common.None"}}</option>{{#each owners}}<option value="{{id}}" {{#if (eq id @root.system.owner)}}selected{{/if}}>{{name}}</option>{{/each}}</select></label>
    <label>{{localize "DEICIDE.Common.Banner"}} <input type="text" name="system.banner" value="{{system.banner}}"></label>
  </div>
  <p class="doctrine-row">{{#each doctrines}}<span class="doctrine-badge {{#if active}}on{{/if}}" data-tooltip="{{label}}"><i class="fa-solid {{icon}}"></i> {{label}}</span>{{/each}}</p>
  <h3>{{localize "DEICIDE.Common.Derived"}}</h3>
  <p class="stat-line"><span>{{localize "DEICIDE.Common.DEF"}} {{derived.def}}</span><span>{{localize "DEICIDE.Common.RES"}} {{derived.res}}</span><span>{{localize "DEICIDE.Company.VsCharacter"}} {{derived.atkVsCharacter}}</span><span>{{localize "DEICIDE.Company.VsCompany"}} {{derived.atkVsCompany}}</span><span>{{localize "DEICIDE.Common.Move"}} {{derived.move}}</span><span>{{localize "DEICIDE.Common.Range"}} {{derived.range.[0]}} {{localize "DEICIDE.Common.To"}} {{derived.range.[1]}}</span>{{#if derived.broadsides}}<span>{{localize "DEICIDE.Company.Broadsides" count=derived.broadsides might=derived.broadsideMight}}</span>{{/if}}</p>
  <p class="stat-line">{{#if derived.wavering}}<span class="warn">{{localize "DEICIDE.Company.Wavering"}}</span>{{/if}}{{#if derived.routed}}<span class="warn">{{localize "DEICIDE.Company.RoutedWarn"}}</span>{{/if}}</p>
  <h3>{{localize "DEICIDE.Company.Veterancy"}} <small>{{localize "DEICIDE.Company.VeterancyOf" value=system.veterancy}}</small></h3>
  <p class="pips">{{#each pips}}<span class="pip {{#if this}}on{{/if}}"></span>{{/each}}</p>
  {{#if isGM}}
  <p class="toolbar">
    <button type="button" data-action="veterancy">{{localize "DEICIDE.Company.Bookkeeping"}}</button>
    {{#if upgradeCost}}<button type="button" data-action="upgrade">{{localize "DEICIDE.Company.Upgrade" cost=upgradeCost}}</button>{{/if}}
    {{#if system.routed}}<button type="button" data-action="reserve">{{localize "DEICIDE.Company.Reserve"}}</button>{{/if}}
  </p>
  {{/if}}
  <h3>{{localize "DEICIDE.Common.Notes"}}</h3>
  <prose-mirror name="system.notes" value="{{system.notes}}" document-uuid="{{actor.uuid}}" toggled>{{{notesHtml}}}</prose-mirror>
</section>
