<section class="deicide-inspector">
  <header class="inspector-header">
    <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
    <div class="titles">
      <input type="text" name="name" value="{{actor.name}}">
      <p class="type">{{localize (concat "TYPES.Actor." actor.type)}}</p>
    </div>
    <button type="button" data-action="resetActor"><i class="fa-solid fa-rotate"></i> {{localize "DEICIDE.Common.Recompute"}}</button>
  </header>
  <details open>
    <summary>{{localize "DEICIDE.Common.Derived"}}</summary>
    <pre>{{derivedJson}}</pre>
  </details>
  <details>
    <summary>{{localize "DEICIDE.Common.Stored"}}</summary>
    <pre>{{sourceJson}}</pre>
  </details>
  <details open>
    <summary>{{localize "DEICIDE.Inspector.Items" count=items.length}}</summary>
    <ul class="plain">
      {{#each items}}
      <li>{{type}}: {{name}}{{#if equipped}} {{localize "DEICIDE.Inspector.Equipped"}}{{/if}}</li>
      {{/each}}
    </ul>
  </details>
</section>
