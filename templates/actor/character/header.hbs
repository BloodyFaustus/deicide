<header class="sheet-header character-header">
  <img class="profile" src="{{actor.img}}" alt="{{actor.name}}" data-action="editImage" data-edit="img">
  <div class="identity">
    <input type="text" name="name" value="{{actor.name}}" placeholder="{{localize 'DEICIDE.Common.Name'}}">
    <div class="line">
      <span>{{localize "DEICIDE.Common.Level"}} <input type="number" name="system.level" value="{{system.level}}" min="1" class="tiny"></span>
      <span>{{localize "DEICIDE.Common.XP"}} <input type="number" name="system.xp" value="{{system.xp}}" min="0" class="small"> / {{tracks.xpNext}}</span>
      <span class="active-class">{{#each classes}}{{#if active}}{{localize "DEICIDE.Character.ActiveClass" name=name rank=rank}}{{/if}}{{/each}}</span>
    </div>
    <div class="line origin">
      <span>{{origin.people.name}}{{#if subtypeName}} ({{subtypeName}}){{/if}}</span>
      <span>{{origin.background.name}}</span>
      <span>{{origin.talent.name}}{{#if talentChoices}} ({{talentChoices}}){{/if}}</span>
      <span class="mode-badge {{mode}}" data-tooltip="{{localize 'DEICIDE.Character.SceneMode'}}">{{modeLabel}}</span>
    </div>
  </div>
  <div class="header-actions">
    <button type="button" data-action="basicAttack" data-tooltip="{{localize 'DEICIDE.Character.AttackHint'}}"><i class="fa-solid fa-sword"></i> {{localize "DEICIDE.Character.Attack"}}</button>
    {{#if derived.isAlchemist}}<button type="button" data-action="harvest" data-tooltip="{{localize 'DEICIDE.Character.HarvestHint'}}"><i class="fa-solid fa-hand-holding"></i> {{localize "DEICIDE.Character.Harvest"}}</button>{{/if}}
    <button type="button" data-action="rest" data-tooltip="{{localize 'DEICIDE.Character.RestHint'}}"><i class="fa-solid fa-campground"></i> {{localize "DEICIDE.Character.Rest"}}</button>
    {{#if isGM}}
    <button type="button" data-action="levelUp" data-tooltip="{{localize 'DEICIDE.Character.LevelUpHint'}}"><i class="fa-solid fa-arrow-up"></i> {{localize "DEICIDE.Character.LevelUp"}}</button>
    <button type="button" data-action="creation" data-tooltip="{{localize 'DEICIDE.Character.CreationHint'}}"><i class="fa-solid fa-wand-magic-sparkles"></i></button>
    {{/if}}
  </div>
</header>
