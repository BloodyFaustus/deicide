<section class="tab overview {{tab.cssClass}}" data-tab="overview" data-group="primary">
  <div class="columns">
    <div class="column attributes">
      <h3>{{localize "DEICIDE.Character.Attributes"}} <small>{{localize "DEICIDE.Character.CapHint"}}</small></h3>
      <table class="attribute-table">
        {{#each attributes}}
        <tr class="{{#if overCap}}over-cap{{/if}} {{#if atCap}}at-cap{{/if}}">
          <th data-tooltip="{{label}}">{{abbr}}</th>
          <td class="value">{{display}}{{#if overCap}} <small class="warn" data-tooltip="{{localize 'DEICIDE.Character.OverCap'}}"><i class="fa-solid fa-triangle-exclamation"></i></small>{{/if}}</td>
          <td class="detail" data-tooltip="{{localize 'DEICIDE.Character.Detail' base=base trained=trained}}{{#if adaptation}}, {{localize 'DEICIDE.Character.Adaptations'}} +{{adaptation}}{{/if}}{{#if accessory}}, {{localize 'DEICIDE.Character.Accessories'}} +{{accessory}}{{/if}}{{#if bonus}}, {{localize 'DEICIDE.Character.Other'}} {{bonus}}{{/if}}">
            <small>{{trained}}{{#if accessory}} +{{accessory}}{{/if}}{{#if bonus}} {{#if (gt bonus 0)}}+{{/if}}{{bonus}}{{/if}}</small>
          </td>
        </tr>
        {{/each}}
      </table>
      {{#if pendingFlex.length}}
      <p class="flex-pending">{{localize "DEICIDE.Character.FlexPending"}} {{#each pendingFlex}}<button type="button" data-action="placeFlex" data-level="{{this}}">{{localize "DEICIDE.Character.FlexLevel" level=this}}</button>{{/each}}</p>
      {{/if}}
      <h3>{{localize "DEICIDE.Character.Defense"}}</h3>
      <p class="stat-line"><span>{{localize "DEICIDE.Common.DEF"}} {{defense.def}}</span><span>{{localize "DEICIDE.Common.RES"}} {{defense.res}}</span><span>{{localize "DEICIDE.Common.Avoid"}} {{#if (gt defense.avoid 0)}}+{{/if}}{{defense.avoid}}</span></p>
      <p class="stat-line"><span>{{localize "DEICIDE.Common.Move"}} {{derived.move}}</span><span>{{localize "DEICIDE.Character.CommandRadius"}} {{derived.commandRadius}}</span><span>{{#each classTypes}}{{this}} {{/each}}</span></p>
      <p class="stat-line"><span>{{localize "DEICIDE.Character.Harvest"}} {{derived.harvestYield}}</span><span>{{localize "DEICIDE.Character.OvercastBurn" value=derived.overcastBurnPerPoint}}</span>{{#if derived.soulPricePayer}}<span>{{localize "DEICIDE.Character.SoulPriceIn" pool=soulPricePool}}</span>{{/if}}</p>
    </div>

    <div class="column pools">
      <h3>{{localize "DEICIDE.Character.Pools"}}</h3>
      <div class="pool hp">
        <label>{{localize "DEICIDE.Common.HP"}}</label>
        <button type="button" class="step" data-action="changePool" data-pool="hp" data-delta="-1">-</button>
        <input type="number" name="system.hp.value" value="{{pools.hp.value}}" min="0"> / {{pools.hp.max}}
        <button type="button" class="step" data-action="changePool" data-pool="hp" data-delta="1">+</button>
      </div>
      <div class="pool channel">
        <label>{{localize "DEICIDE.Common.Channel"}}</label>
        {{#if pools.channel}}
          <button type="button" class="step" data-action="changePool" data-pool="channel" data-delta="-1">-</button>
          <input type="number" name="system.channel.value" value="{{pools.channel.value}}" min="0"> / {{pools.channel.max}}
          <button type="button" class="step" data-action="changePool" data-pool="channel" data-delta="1">+</button>
          <small data-tooltip="{{localize 'DEICIDE.Character.ChannelHint' formula=pools.channel.formula innate=pools.channel.innate}}">{{localize "DEICIDE.Character.ChannelBase" formula=pools.channel.formula}}</small>
        {{else}}
          <span class="no-mana">{{localize "DEICIDE.Character.NoMana"}}</span>
        {{/if}}
      </div>
      {{#if pools.matter}}
      <div class="pool matter">
        <label>{{localize "DEICIDE.Common.Matter"}}</label>
        <button type="button" class="step" data-action="changePool" data-pool="matter" data-delta="-1">-</button>
        <input type="number" name="system.matter.value" value="{{pools.matter.value}}" min="0"> / {{pools.matter.max}}
        <button type="button" class="step" data-action="changePool" data-pool="matter" data-delta="1">+</button>
      </div>
      {{/if}}
      {{#if pools.static}}
      <div class="pool static">
        <label>{{localize "DEICIDE.Common.Static"}}</label>
        <button type="button" class="step" data-action="changePool" data-pool="static" data-delta="-1">-</button>
        <input type="number" name="system.static" value="{{pools.static.value}}" min="0"> / {{pools.static.max}}
        <button type="button" class="step" data-action="changePool" data-pool="static" data-delta="1">+</button>
      </div>
      {{/if}}
      {{#if pools.stolen}}
      <div class="pool stolen">
        <label>{{localize "DEICIDE.Character.StolenSlots"}}</label>
        <span>{{pools.stolen.stored.length}} / {{pools.stolen.slots}}</span>
      </div>
      {{/if}}

      <h3>{{localize "DEICIDE.Character.Tracks"}}</h3>
      <div class="tracks">
        {{#if (ne tracks.manaburn null)}}<label>{{localize "DEICIDE.Character.Manaburn"}} <input type="number" name="system.manaburn" value="{{tracks.manaburn}}" min="0" max="100"></label>{{/if}}
        {{#if (ne tracks.saturation null)}}<label>{{localize "DEICIDE.Character.Saturation"}} <input type="number" name="system.saturation" value="{{tracks.saturation}}" min="0" max="100"></label>{{/if}}
        {{#if (ne tracks.divineAttention null)}}<label>{{localize "DEICIDE.Character.DivineAttention"}} <input type="number" name="system.divineAttention" value="{{tracks.divineAttention}}" min="0"></label>{{/if}}
        <label>{{localize "DEICIDE.Character.Marks"}} <input type="number" name="system.marks" value="{{tracks.marks}}" min="0"></label>
        <label>{{localize "DEICIDE.Common.Dust"}} <input type="number" name="system.dust" value="{{system.dust}}" min="0"></label>
        <label>{{localize "DEICIDE.Common.Debt"}} <input type="number" name="system.debt" value="{{system.debt}}" min="0"></label>
        <label>{{localize "DEICIDE.Common.Row"}} <select name="system.row"><option value="front" {{#if (eq system.row "front")}}selected{{/if}}>{{localize "DEICIDE.Common.Front"}}</option><option value="back" {{#if (eq system.row "back")}}selected{{/if}}>{{localize "DEICIDE.Common.Back"}}</option></select></label>
      </div>
      {{#if (ne tracks.divineAttention null)}}
      <h3>{{localize "DEICIDE.Character.DivineLog"}} <button type="button" class="inline-control icon fa-solid fa-plus" data-action="logDivine" data-tooltip="{{localize 'DEICIDE.Character.DivineLogAdd'}}"></button></h3>
      <ul class="plain divine-log">
        {{#each divineLog}}<li><small>M{{month}}</small> {{source}} <strong>{{#if (gt delta 0)}}+{{/if}}{{delta}}</strong></li>{{else}}<li class="empty">{{localize "DEICIDE.Character.DivineLogEmpty"}}</li>{{/each}}
      </ul>
      {{/if}}

      <h3>{{localize "DEICIDE.Character.Proficiencies"}}</h3>
      <ul class="proficiencies plain">
        {{#each proficiencies}}<li class="{{#unless grade}}untrained{{/unless}}"><span>{{label}}</span><strong>{{#if grade}}{{grade}}{{else}}&mdash;{{/if}}</strong></li>{{/each}}
      </ul>
    </div>
  </div>
  {{#if derived.missing.length}}
  <p class="warning">{{localize "DEICIDE.Character.Missing"}} {{#each derived.missing}}{{type}} {{id}} {{/each}}</p>
  {{/if}}
</section>
