<section class="tab classes {{tab.cssClass}}" data-tab="classes" data-group="primary">
  <div class="toolbar">
    {{#if isGM}}
    <button type="button" data-action="awardXp"><i class="fa-solid fa-star"></i> {{localize "DEICIDE.Character.AwardXp"}}</button>
    <button type="button" data-action="awardCp"><i class="fa-solid fa-medal"></i> {{localize "DEICIDE.Character.AwardCp"}}</button>
    {{/if}}
    <button type="button" data-action="classTree"><i class="fa-solid fa-sitemap"></i> {{localize "DEICIDE.Character.ClassTree"}}</button>
    <span class="hint">{{localize "DEICIDE.Character.TierGates" t2=tierGates.[0] t3=tierGates.[1] t4=tierGates.[2] cap=derived.capTier}}</span>
  </div>

  <h3>{{localize "DEICIDE.Character.Classes"}}</h3>
  <ul class="class-list plain">
    {{#each classes}}
    <li class="class-row {{#if active}}active{{/if}}">
      <div class="class-main">
        <strong data-action="openEntry" data-type="class" data-identifier="{{id}}">{{name}}</strong>
        <span>{{localize "DEICIDE.Character.TierRank" tier=tier rank=rank}}</span>
        <span class="cp" data-tooltip="{{localize 'DEICIDE.Character.CpHint'}}">CP {{cp}}{{#if nextCp}} / {{nextCp}}{{/if}}</span>
        <span class="bar"><span class="fill" style="width: {{progress}}%"></span></span>
        {{#unless active}}<button type="button" data-action="activateClass" data-class-id="{{id}}">{{localize "DEICIDE.Character.MakeActive"}}</button>{{else}}<span class="badge">{{localize "DEICIDE.Character.Active"}}</span>{{/unless}}
      </div>
      <ul class="ladder plain">
        {{#each skills}}<li class="{{#if known}}known{{else}}locked{{/if}}"><small>R{{rank}}</small> {{name}}</li>{{/each}}
      </ul>
    </li>
    {{/each}}
  </ul>

  <h3>{{localize "DEICIDE.Character.Reachable"}} <small>{{localize "DEICIDE.Character.ReachableHint"}}</small></h3>
  <ul class="available plain">
    {{#each availableClasses}}
    <li class="{{#if ok}}ok{{else}}locked{{/if}}">
      <strong data-action="openEntry" data-type="class" data-identifier="{{id}}">{{name}}</strong>
      <span>{{localize "DEICIDE.Common.Tier"}} {{tier}}</span>
      {{#if ok}}
        {{#if cost}}
          <button type="button" data-action="commission" data-class-id="{{id}}" data-tooltip="{{localize 'DEICIDE.Character.CostHint' dust=cost.dust}}{{#if cost.legitimacy}} {{localize 'DEICIDE.Character.CostLegitimacy' legitimacy=cost.legitimacy}}{{/if}}">{{#if (eq tier 3)}}{{localize "DEICIDE.Character.RoyalWarrant"}}{{else}}{{localize "DEICIDE.Character.Commission"}}{{/if}} ({{localize "DEICIDE.Character.CostHint" dust=cost.dust}})</button>
        {{else}}
          <button type="button" data-action="addClass" data-class-id="{{id}}">{{localize "DEICIDE.Character.Enter"}}</button>
        {{/if}}
      {{else}}
        <span class="missing">{{missingText}}</span>
      {{/if}}
    </li>
    {{/each}}
  </ul>
</section>
