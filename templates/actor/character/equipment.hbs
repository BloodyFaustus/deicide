<section class="tab equipment {{tab.cssClass}}" data-tab="equipment" data-group="primary">
  <h3>{{localize "DEICIDE.Character.Slots"}} <small>{{localize "DEICIDE.Common.Dust"}} {{dust}}</small></h3>
  <div class="slots">
    {{#each equipment.slots}}
    <div class="slot-box">
      <label>{{label}}{{#if (gt count 1)}} ({{items.length}}/{{count}}){{/if}}</label>
      {{#each items}}
      <div class="item-row" data-item-id="{{id}}">
        <img src="{{img}}" alt="{{name}}">
        <span class="name" data-action="editItem">{{name}}</span>
        <span class="summary">{{summary}}</span>
        <button type="button" class="inline-control icon fa-solid fa-xmark" data-action="toggleEquipped" data-tooltip="{{localize 'DEICIDE.Common.Unequip'}}"></button>
      </div>
      {{else}}
      <span class="empty">{{localize "DEICIDE.Character.Empty"}}</span>
      {{/each}}
    </div>
    {{/each}}
  </div>

  <h3>{{localize "DEICIDE.Character.Belt"}} <small>{{localize "DEICIDE.Character.BeltHint" count=equipment.belt.length slots=equipment.beltSlots}}</small></h3>
  <ul class="item-list plain">
    {{#each equipment.belt}}
    <li class="item-row {{#if onBelt}}on-belt{{/if}}" data-item-id="{{id}}">
      <img src="{{img}}" alt="{{name}}">
      <span class="name" data-action="editItem">{{name}}</span>
      <span class="quantity">x{{quantity}}</span>
      <span class="summary">{{summary}}</span>
      <button type="button" class="inline-control {{#if onBelt}}on{{/if}}" data-action="toggleBelt" data-tooltip="{{localize 'DEICIDE.Character.OnBelt'}}">{{#if onBelt}}{{localize "DEICIDE.Character.OnBeltShort"}}{{else}}{{localize "DEICIDE.Character.Pack"}}{{/if}}</button>
      <button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteItem" data-tooltip="{{localize 'DEICIDE.Common.Delete'}}"></button>
    </li>
    {{/each}}
  </ul>

  <h3>{{localize "DEICIDE.Character.Inventory"}} <small>{{localize "DEICIDE.Character.InventoryHint"}}</small></h3>
  <ul class="item-list plain">
    {{#each equipment.inventory}}
    <li class="item-row {{#if equipped}}equipped{{/if}} {{#if invalid}}invalid{{/if}}" data-item-id="{{id}}" draggable="true">
      <img src="{{img}}" alt="{{name}}">
      <span class="name" data-action="editItem">{{name}}{{#if named}} <i class="fa-solid fa-star" data-tooltip="{{localize 'DEICIDE.Character.Named'}}"></i>{{/if}}</span>
      <span class="type">{{typeLabel}}</span>
      <span class="summary">{{summary}}</span>
      <span class="pp" data-tooltip="{{localize 'DEICIDE.Character.PpHint'}}">{{#if pp}}{{localize "DEICIDE.Character.PP"}} {{pp}}{{/if}}{{#if price}}, {{price}} {{localize "DEICIDE.Common.Dust"}}{{/if}}</span>
      <button type="button" class="inline-control {{#if equipped}}on{{/if}}" data-action="toggleEquipped">{{#if equipped}}{{localize "DEICIDE.Common.Equipped"}}{{else}}{{localize "DEICIDE.Common.Equip"}}{{/if}}</button>
      <button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteItem" data-tooltip="{{localize 'DEICIDE.Common.Delete'}}"></button>
    </li>
    {{/each}}
  </ul>

  {{#if equipment.supplies.length}}
  <h3>{{localize "DEICIDE.Character.Supplies"}}</h3>
  <ul class="item-list plain">
    {{#each equipment.supplies}}
    <li class="item-row" data-item-id="{{id}}"><img src="{{img}}" alt="{{name}}"><span class="name" data-action="editItem">{{name}}</span><span class="quantity">x{{quantity}}</span><span class="summary">{{summary}}</span><button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteItem"></button></li>
    {{/each}}
  </ul>
  {{/if}}

  {{#if equipment.other.length}}
  <h3>{{localize "DEICIDE.Character.Overrides"}} <small>{{localize "DEICIDE.Character.OverridesHint"}}</small></h3>
  <ul class="item-list plain">
    {{#each equipment.other}}
    <li class="item-row" data-item-id="{{id}}"><img src="{{img}}" alt="{{name}}"><span class="name" data-action="editItem">{{name}}</span><span class="type">{{typeLabel}}</span><button type="button" class="inline-control icon fa-solid fa-trash" data-action="deleteItem"></button></li>
    {{/each}}
  </ul>
  {{/if}}
  <p class="hint">{{localize "DEICIDE.Character.DropHint"}}</p>
</section>
