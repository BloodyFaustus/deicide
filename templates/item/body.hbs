<section class="item-body type-{{type}}">
  {{#if (eq type "ability")}}
    <div class="grid three">
      <label>{{localize "DEICIDE.Item.Type"}} <select name="system.type">{{#each skillTypes}}<option value="{{id}}" {{#if (eq id @root.system.type)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.Weight"}} <input type="number" name="system.weight" value="{{system.weight}}" min="0" placeholder="8"></label>
      <label>{{localize "DEICIDE.Item.Automation"}} <select name="system.automation">{{#each automationLevels}}<option value="{{this}}" {{#if (eq this @root.system.automation)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.Source"}} <input type="text" name="system.source.id" value="{{system.source.id}}"> {{localize "DEICIDE.Item.Rank"}} <input type="number" name="system.source.rank" value="{{system.source.rank}}" class="tiny"></label>
      <label>{{localize "DEICIDE.Item.Tags"}} <input type="text" data-list="tags" value="{{#each system.tags}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}" placeholder="{{localize 'DEICIDE.Item.TagsHint'}}"></label>
      <label><input type="checkbox" name="system.direct" {{#if system.direct}}checked{{/if}}> {{localize "DEICIDE.Item.Direct"}}</label>
      <label>{{localize "DEICIDE.Common.Channel"}} <input type="number" name="system.cost.channel" value="{{system.cost.channel}}" min="0"></label>
      <label>{{localize "DEICIDE.Common.Matter"}} <input type="number" name="system.cost.matter" value="{{system.cost.matter}}" min="0"></label>
      <label>{{localize "DEICIDE.Common.HP"}} <input type="number" name="system.cost.hp" value="{{system.cost.hp}}" min="0"></label>
      <label>{{localize "DEICIDE.Common.Dust"}} <input type="number" name="system.cost.dust" value="{{system.cost.dust}}" min="0"></label>
      <label>{{localize "DEICIDE.Item.SoulPrice"}} <input type="number" name="system.cost.soulPrice" value="{{system.cost.soulPrice}}" min="0"></label>
      <label>{{localize "DEICIDE.Item.Uses"}} <input type="number" name="system.usage.limit" value="{{system.usage.limit}}" min="1" class="tiny"> {{localize "DEICIDE.Common.Per"}} <input type="text" name="system.usage.per" value="{{system.usage.per}}" class="small"></label>
    </div>
    <label>{{localize "DEICIDE.Common.Summary"}} <input type="text" name="system.summary" value="{{system.summary}}"></label>
    {{#if (eq system.type "reaction")}}<label>{{localize "DEICIDE.Item.Trigger"}} <input type="text" name="system.trigger" value="{{system.trigger}}"></label>{{/if}}
    <details open><summary>{{localize "DEICIDE.Item.Engines" engines=engineLabels}}</summary>
      <p class="collapse">{{localize "DEICIDE.Item.War"}} {{#if system.war}}{{localize "DEICIDE.Item.WarLine" range=system.war.range shape=system.war.area.shape size=system.war.area.size target=system.war.target}}{{#if system.war.movement}}, {{system.war.movement}}{{/if}}{{#if system.war.terrain}}, {{localize "DEICIDE.Item.Terrain"}}{{/if}}{{else}}{{localize "DEICIDE.Common.None"}}{{/if}}</p>
      <p class="collapse">{{localize "DEICIDE.Item.Dungeon"}} {{#if collapse.available}}{{collapse.reach}} {{localize "DEICIDE.Character.Reach"}}, {{collapse.target}} {{localize "DEICIDE.Character.Target"}}, {{localize "DEICIDE.Common.Weight"}} {{collapse.weight}}{{#if collapse.rowSwap}}, {{localize "DEICIDE.Item.RowSwap"}}{{/if}}{{#if collapse.barrier}}, {{localize "DEICIDE.Character.Barrier"}} {{collapse.barrier.formula}}{{/if}}{{#if collapse.overridden}} {{localize "DEICIDE.Item.Override"}}{{/if}}{{#if collapse.requiresArena}}, {{localize "DEICIDE.Item.ArenaOnly"}}{{/if}}{{else}}{{localize "DEICIDE.Item.Unavailable"}}{{/if}}{{#if collapse.note}}. {{collapse.note}}{{/if}}</p>
    </details>
    <details><summary>{{localize "DEICIDE.Item.AttackJson"}}</summary><textarea data-json="attack" rows="8">{{attackJson}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.WarJson"}}</summary><textarea data-json="war" rows="6">{{warJson}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.DungeonJson"}}</summary><textarea data-json="dungeon" rows="5">{{dungeonJson}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.ModifiersJson"}}</summary><textarea data-json="modifiers" rows="6">{{modifiersJson}}</textarea><p class="hint">{{#each modifierList}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}</p></details>
    <details><summary>{{localize "DEICIDE.Item.StatusesJson"}}</summary><textarea data-json="statuses" rows="4">{{statusesJson}}</textarea></details>
  {{/if}}

  {{#if (eq type "class")}}
    <div class="grid three">
      <label>{{localize "DEICIDE.Common.Tier"}} <input type="number" name="system.tier" value="{{system.tier}}" min="1" max="4"></label>
      <label>{{localize "DEICIDE.Item.HpGrowth"}} <input type="number" name="system.hp" value="{{system.hp}}" min="0"></label>
      <label>{{localize "DEICIDE.Item.MoveOverride"}} <input type="number" name="system.move" value="{{system.move}}" placeholder="{{localize 'DEICIDE.Item.ByType'}}"></label>
      <label>{{localize "DEICIDE.Item.StoryGate"}} <input type="text" name="system.storyGate" value="{{system.storyGate}}"></label>
      <label>{{localize "DEICIDE.Item.Ladder"}} <select name="system.ladder"><option value="standard" {{#if (eq system.ladder "standard")}}selected{{/if}}>{{localize "DEICIDE.Item.Standard"}}</option><option value="legend" {{#if (eq system.ladder "legend")}}selected{{/if}}>{{localize "DEICIDE.Item.Legend"}}</option></select></label>
      <label><input type="checkbox" name="system.enemyOnly" {{#if system.enemyOnly}}checked{{/if}}> {{localize "DEICIDE.Item.EnemyOnly"}}</label>
    </div>
    <p class="tags">{{#each types}}<label class="tag"><input type="checkbox" data-class-type="{{id}}" {{#if active}}checked{{/if}}> {{label}}</label>{{/each}}</p>
    <h3>{{localize "DEICIDE.Item.Growth"}} <small>{{localize "DEICIDE.Item.GrowthHint" printed=derived.printedTenths total=derived.tierTotalTenths}}</small></h3>
    <table class="growth-table"><tr>{{#each growth}}<th>{{abbr}}</th>{{/each}}</tr>
      <tr>{{#each growth}}<td><input type="text" name="system.growth.{{attr}}" value="{{letter}}" class="tiny" maxlength="1"></td>{{/each}}</tr>
      <tr>{{#each growth}}<td><small>{{localize "DEICIDE.Item.Tenths" tenths=tenths cap=cap}}</small></td>{{/each}}</tr>
    </table>
    <label>{{localize "DEICIDE.Item.TrainsPrimary"}} <input type="text" data-list="trains.primary" value="{{trainsPrimary}}"></label>
    <label>{{localize "DEICIDE.Item.TrainsSecondary"}} <input type="text" data-list="trains.secondary" value="{{trainsSecondary}}"></label>
    <label>{{localize "DEICIDE.Item.PrereqText"}} <input type="text" name="system.prerequisiteText" value="{{system.prerequisiteText}}"></label>
    <details><summary>{{localize "DEICIDE.Item.PrereqJson"}}</summary><textarea data-json="prerequisites" rows="5">{{prerequisitesJson}}</textarea></details>
    <h3>{{localize "DEICIDE.Item.SkillLadder"}}</h3>
    <ul class="plain ladder">{{#each skills}}<li><small>R{{rank}}</small> {{name}} <code>{{id}}</code>{{#if mastery}} {{localize "DEICIDE.Item.Mastery"}}{{/if}}</li>{{/each}}</ul>
    <h3>{{localize "DEICIDE.Item.StartSpread"}}</h3>
    <div class="grid four">{{#each growth}}<label>{{abbr}} <input type="number" name="system.startSpread.{{attr}}" value="{{lookup @root.system.startSpread attr}}" min="0"></label>{{/each}}</div>
  {{/if}}

  {{#if (eq type "origin")}}
    <div class="grid two">
      <label>{{localize "DEICIDE.Item.Kind"}} <select name="system.kind">{{#each kinds}}<option value="{{this}}" {{#if (eq this @root.system.kind)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label><input type="checkbox" name="system.story" {{#if system.story}}checked{{/if}}> {{localize "DEICIDE.Item.StoryOrigin"}}</label>
    </div>
    <label>{{localize "DEICIDE.Item.Text"}} <input type="text" name="system.text" value="{{system.text}}"></label>
    <details open><summary>{{localize "DEICIDE.Item.Mechanics"}}</summary><pre>{{detailJson}}</pre></details>
    <details><summary>{{localize "DEICIDE.Item.ModifiersJson"}}</summary><textarea data-json="modifiers" rows="5">{{originJson.modifiers}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.FlagsJson"}}</summary><textarea data-json="flags" rows="4">{{originJson.flags}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.GrantsJson"}}</summary><textarea data-json="grants" rows="5">{{originJson.grants}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.PointsJson"}}</summary><textarea data-json="points" rows="3">{{originJson.points}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.GrowthJson"}}</summary><textarea data-json="growth" rows="3">{{originJson.growth}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.SubtypesJson"}}</summary><textarea data-json="subtypes" rows="4">{{originJson.subtypes}}</textarea></details>
  {{/if}}

  {{#if (eq type "weapon")}}
    <div class="grid four">
      <label>{{localize "DEICIDE.Item.Line"}} <select name="system.line">{{#each lines}}<option value="{{this}}" {{#if (eq this @root.system.line)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.Tier"}} <select name="system.tier">{{#each tiers}}<option value="{{this}}" {{#if (eq this @root.system.tier)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.Prefix"}} <select name="system.prefix"><option value="">{{localize "DEICIDE.Common.None"}}</option>{{#each prefixes}}<option value="{{this}}" {{#if (eq this @root.system.prefix)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.Forge"}} <input type="number" name="system.forge" value="{{system.forge}}" min="0" max="3"></label>
      {{#if (eq system.prefix "runed")}}<label>{{localize "DEICIDE.Item.Element"}} <select name="system.element"><option value="">{{localize "DEICIDE.Common.Choose"}}</option>{{#each elements}}<option value="{{id}}" {{#if (eq id @root.system.element)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
      <label><input type="checkbox" name="system.asSidearm" {{#if system.asSidearm}}checked{{/if}}> {{localize "DEICIDE.Item.Sidearm"}}</label>
      <label>{{localize "DEICIDE.Item.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label>
    </div>
    {{#if derived.invalid}}<p class="warn">{{derived.invalid}}</p>{{/if}}
    <h3>{{localize "DEICIDE.Item.Profile"}}</h3>
    {{#if derived.caster}}
    <p class="stat-line"><span>{{localize "DEICIDE.Item.Bonus"}} +{{#if derived.spellBonus}}{{derived.spellBonus}}{{else}}{{derived.alchemyBonus}}{{/if}}</span>{{#if derived.healBonus}}<span>{{localize "DEICIDE.Item.Heal"}} +{{derived.healBonus}}</span>{{/if}}{{#if derived.channel}}<span>{{localize "DEICIDE.Common.Channel"}} +{{derived.channel}}</span>{{/if}}{{#if derived.matter}}<span>{{localize "DEICIDE.Common.Matter"}} +{{derived.matter}}</span>{{/if}}<span>{{localize "DEICIDE.Common.Acc"}} +{{derived.acc}}</span><span>{{localize "DEICIDE.Common.Crit"}} {{derived.crit}}</span>{{#if derived.spellWeight}}<span>{{localize "DEICIDE.Item.SpellWeight"}} {{derived.spellWeight}}</span>{{/if}}</p>
    {{else}}
    <p class="stat-line"><span>{{localize "DEICIDE.Common.Might"}} {{derived.might}}</span><span>{{localize "DEICIDE.Common.Acc"}} +{{derived.acc}}</span><span>{{localize "DEICIDE.Common.Crit"}} {{derived.crit}}</span><span>{{localize "DEICIDE.Common.Range"}} {{derived.range.[0]}} {{localize "DEICIDE.Common.To"}} {{derived.range.[1]}}</span><span>{{localize "DEICIDE.Common.Weight"}} {{derived.weight}}</span>{{#if derived.effectiveVs}}<span>{{localize "DEICIDE.Item.EffectiveVs" type=derived.effectiveVs}}</span>{{/if}}{{#if derived.attacksTwice}}<span>{{localize "DEICIDE.Item.Brave"}}</span>{{/if}}{{#if derived.res}}<span>{{localize "DEICIDE.Common.RES"}} +{{derived.res}}</span>{{/if}}</p>
    {{/if}}
    <p class="stat-line"><span>{{localize "DEICIDE.Item.Gate"}} {{derived.gate}}</span><span>{{localize "DEICIDE.Item.Prof"}} {{derived.prof}}</span></p>
    <h3>{{localize "DEICIDE.Item.PowerPoints"}} <small>{{localize "DEICIDE.Item.PriceFormula"}}</small></h3>
    <ul class="plain pp">{{#each ppBreakdown}}<li><span>{{label}}</span><strong>{{value}}</strong></li>{{/each}}<li class="total"><span>{{localize "DEICIDE.Item.Total" pp=derived.pp}}</span><strong>{{derived.price}} {{localize "DEICIDE.Common.Dust"}}</strong> <small>{{localize "DEICIDE.Item.Sells" price=derived.sellPrice}}</small></li></ul>
    {{#if arts.length}}<p class="stat-line">{{localize "DEICIDE.Item.Arts"}} {{#each arts}}<span>{{this}}</span>{{/each}}</p>{{/if}}
  {{/if}}

  {{#if (eq type "armor")}}
    <p class="stat-line"><span>{{localize "DEICIDE.Common.DEF"}} +{{derived.def}}</span><span>{{localize "DEICIDE.Common.RES"}} +{{derived.res}}</span><span>{{localize "DEICIDE.Item.Burden"}} {{derived.burden}}</span>{{#if derived.avoid}}<span>{{localize "DEICIDE.Common.Avoid"}} +{{derived.avoid}}</span>{{/if}}{{#if derived.hp}}<span>{{localize "DEICIDE.Common.HP"}} +{{derived.hp}}</span>{{/if}}<span>{{localize "DEICIDE.Character.PP"}} {{derived.pp}}</span><span>{{derived.price}} {{localize "DEICIDE.Common.Dust"}}</span></p>
    {{#unless derived.known}}<p class="warn">{{localize "DEICIDE.Item.UnknownArmor"}}</p>{{/unless}}
  {{/if}}

  {{#if (eq type "offhand")}}
    <div class="grid two">
      <label>{{localize "DEICIDE.Item.Line"}} <select name="system.line">{{#each lines}}<option value="{{this}}" {{#if (eq this @root.system.line)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.Tier"}} <select name="system.tier">{{#each tiers}}<option value="{{this}}" {{#if (eq this @root.system.tier)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
    </div>
    {{#if derived.invalid}}<p class="warn">{{derived.invalid}}</p>{{/if}}
    <p class="stat-line">{{#each modifierList}}<span>{{this}}</span>{{/each}}<span>{{derived.price}} {{localize "DEICIDE.Common.Dust"}}</span></p>
  {{/if}}

  {{#if (eq type "accessory")}}
    <div class="grid two">
      <label>{{localize "DEICIDE.Item.TableEntry"}} <select name="system.key">{{#each keys}}<option value="{{this}}" {{#if (eq this @root.system.key)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      {{#if needsAttribute}}<label>{{localize "DEICIDE.Item.Attribute"}} <select name="system.choices.attribute"><option value="">{{localize "DEICIDE.Common.Choose"}}</option>{{#each attributes}}<option value="{{id}}" {{#if (eq id @root.system.choices.attribute)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
      {{#if needsSecond}}<label>{{localize "DEICIDE.Item.SecondAttribute"}} <select name="system.choices.secondAttribute"><option value="">{{localize "DEICIDE.Common.Choose"}}</option>{{#each attributes}}<option value="{{id}}" {{#if (eq id @root.system.choices.secondAttribute)}}selected{{/if}}>{{label}}</option>{{/each}}</select></label>{{/if}}
      {{#if needsSkill}}<label>{{localize "DEICIDE.Item.SkillId"}} <input type="text" name="system.choices.skill" value="{{system.choices.skill}}" placeholder="soldierBash"></label>{{/if}}
    </div>
    <p class="stat-line">{{#each modifierList}}<span>{{this}}</span>{{/each}}{{#if derived.immune.length}}<span>{{localize "DEICIDE.Item.Immune" list=derived.immune}}</span>{{/if}}<span>{{derived.price}} {{localize "DEICIDE.Common.Dust"}}</span></p>
  {{/if}}

  {{#if (eq type "pin")}}
    <div class="grid two">
      <label>{{localize "DEICIDE.Item.AbilityId"}} <input type="text" name="system.ability" value="{{system.ability}}"></label>
      <label>{{localize "DEICIDE.Item.Price"}} <input type="number" name="system.price" value="{{system.price}}" min="0"></label>
    </div>
  {{/if}}

  {{#if (eq type "consumable")}}
    <div class="grid three">
      <label>{{localize "DEICIDE.Item.Kind"}} <select name="system.kind"><option value="belt" {{#if (eq system.kind "belt")}}selected{{/if}}>{{localize "DEICIDE.Item.BeltKind"}}</option><option value="supply" {{#if (eq system.kind "supply")}}selected{{/if}}>{{localize "DEICIDE.Item.SupplyKind"}}</option></select></label>
      <label>{{localize "DEICIDE.Item.TableEntry"}} <select name="system.key">{{#each keys}}<option value="{{this}}" {{#if (eq this @root.system.key)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.Quantity"}} <input type="number" name="system.quantity" value="{{system.quantity}}" min="0"></label>
      <label><input type="checkbox" name="system.onBelt" {{#if system.onBelt}}checked{{/if}}> {{localize "DEICIDE.Item.OnBelt"}}</label>
    </div>
    {{#if derived.price}}<p class="stat-line"><span>{{derived.price}} {{localize "DEICIDE.Common.Dust"}}</span></p>{{/if}}
  {{/if}}

  {{#if (eq type "named")}}
    <div class="grid three">
      <label>{{localize "DEICIDE.Item.Fills"}} <select name="system.fills">{{#each slots}}<option value="{{this}}" {{#if (eq this @root.system.fills)}}selected{{/if}}>{{this}}</option>{{/each}}</select></label>
      <label>{{localize "DEICIDE.Item.BaseLine"}} <input type="text" name="system.base.line" value="{{system.base.line}}" placeholder="sword"></label>
      <label>{{localize "DEICIDE.Item.BaseTier"}} <input type="text" name="system.base.tier" value="{{system.base.tier}}" placeholder="royal"></label>
      <label>{{localize "DEICIDE.Character.PP"}} <input type="number" name="system.pp" value="{{system.pp}}" min="0"> <small>{{#if (gt system.pp 45)}}{{localize "DEICIDE.Item.Over45"}}{{/if}}{{#if (lt system.pp 32)}}{{localize "DEICIDE.Item.Under32"}}{{/if}}</small></label>
      <label>{{localize "DEICIDE.Item.Hook"}} <input type="text" name="system.hook" value="{{system.hook}}"></label>
      <label>{{localize "DEICIDE.Item.Special"}} <input type="text" name="system.special" value="{{system.special}}"></label>
    </div>
    <p class="stat-line">{{#if derived.might}}<span>{{localize "DEICIDE.Common.Might"}} {{derived.might}}</span>{{/if}}{{#if derived.acc}}<span>{{localize "DEICIDE.Common.Acc"}} +{{derived.acc}}</span>{{/if}}{{#if derived.crit}}<span>{{localize "DEICIDE.Common.Crit"}} {{derived.crit}}</span>{{/if}}{{#if derived.alchemyBonus}}<span>{{localize "DEICIDE.Attribute.alchemy"}} +{{derived.alchemyBonus}}</span>{{/if}}{{#each modifierList}}<span>{{this}}</span>{{/each}}</p>
    <details open><summary>{{localize "DEICIDE.Item.StatsJson"}}</summary><textarea data-json="stats" rows="5">{{statsJson}}</textarea></details>
    <details><summary>{{localize "DEICIDE.Item.ModifiersJson"}}</summary><textarea data-json="modifiers" rows="5">{{modifiersJson}}</textarea></details>
    <details open><summary>{{localize "DEICIDE.Item.DrawbackJson"}}</summary><textarea data-json="drawback" rows="4">{{drawbackJson}}</textarea></details>
    {{#unless system.drawback.text}}<p class="warn">{{localize "DEICIDE.Item.NeedsDrawback"}}</p>{{/unless}}
  {{/if}}

  <h3>{{localize "DEICIDE.Common.Description"}}</h3>
  <prose-mirror name="system.description" value="{{system.description}}" document-uuid="{{item.uuid}}" toggled>{{{descriptionHtml}}}</prose-mirror>
</section>
