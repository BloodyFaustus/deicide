<div class="deicide-scenario-edit">
  <div class="form-group">
    <label>{{localize "DEICIDE.Scenario.Kind"}}</label>
    <select name="system.kind"><option value="war" {{#if (eq system.kind "war")}}selected{{/if}}>{{localize "DEICIDE.Scenario.War"}}</option><option value="dungeon" {{#if (eq system.kind "dungeon")}}selected{{/if}}>{{localize "DEICIDE.Scenario.Dungeon"}}</option></select>
  </div>
  <div class="form-group"><label>{{localize "DEICIDE.Scenario.Month"}}</label><input type="number" name="system.warMonth" value="{{system.warMonth}}" min="1" max="12"></div>
  <div class="form-group"><label>{{localize "DEICIDE.Scenario.Difficulty"}}</label><select name="system.difficulty">{{#each difficulties}}<option value="{{this}}" {{#if (eq this @root.system.difficulty)}}selected{{/if}}>{{this}}</option>{{/each}}</select></div>
  <div class="form-group"><label>{{localize "DEICIDE.Scenario.PayoutTracks"}}</label><textarea name="payoutTracksJson" rows="3">{{tracksJson}}</textarea></div>
  <div class="form-group"><label>{{localize "DEICIDE.Scenario.PayoutDust"}}</label><input type="number" name="system.payout.dust" value="{{system.payout.dust}}" min="0"></div>
  <div class="form-group"><label>{{localize "DEICIDE.Scenario.Drops"}}</label><input type="text" name="dropsText" value="{{dropsText}}" placeholder="redWater, steelGauntlet"></div>
  <div class="form-group"><label>{{localize "DEICIDE.Scenario.Card"}}</label><textarea name="cardJson" rows="12">{{cardJson}}</textarea></div>
  <div class="form-group stacked"><label>{{localize "DEICIDE.Scenario.Briefing"}}</label><prose-mirror name="system.description" value="{{system.description}}" document-uuid="{{page.uuid}}" toggled>{{{descriptionHtml}}}</prose-mirror></div>
</div>
