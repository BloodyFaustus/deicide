<div class="stage-root">
  {{#unless combat}}
    <p class="empty">No Dungeon combat is running.</p>
  {{else}}
  <header class="stage-header">
    <span class="tick">Tick {{tick}}</span>
    <span class="current">{{#if currentName}}{{currentName}} acts{{/if}}</span>
    {{#if isGM}}
    <span class="controls">
      <button type="button" data-action="endAction" data-weight="6" data-tooltip="Light action, Weight 6">W6</button>
      <button type="button" data-action="endAction" data-weight="8" data-tooltip="Standard action, Weight 8">W8</button>
      <button type="button" data-action="endAction" data-weight="12" data-tooltip="Heavy action, Weight 12">W12</button>
      <button type="button" data-action="endAction" data-weight="6" data-guard="true" data-tooltip="Guard"><i class="fa-solid fa-shield-halved"></i></button>
    </span>
    {{/if}}
  </header>

  <div class="battlefield">
    {{#each rows as |sideRows side|}}
    <div class="side side-{{side}}">
      <h3>{{#if (eq side "party")}}Party{{else}}Enemy{{/if}}</h3>
      {{#each sideRows as |list row|}}
      <div class="row-cell" data-side="{{side}}" data-row="{{row}}">
        <div class="row-title">
          <span>{{row}} row ({{list.length}}/{{@root.capacity}})</span>
          <span class="barrier" data-action="setBarrier" data-side="{{side}}" data-row="{{row}}" data-tooltip="Barrier pool. Click to set.">
            <i class="fa-solid fa-shield"></i> {{lookup (lookup @root.barriers side) row}}
          </span>
        </div>
        <div class="units">
          {{#each list}}
          <div class="unit {{#if current}}current{{/if}} {{#if defeated}}defeated{{/if}} {{#if targeted}}targeted{{/if}}" draggable="true" data-combatant-id="{{id}}" data-action="target" data-tooltip="Click to target. Drag to another row.">
            <img src="{{img}}" alt="{{name}}">
            <div class="unit-text">
              <strong>{{name}}</strong>
              <span class="small">{{hp}} {{#if guard}}<i class="fa-solid fa-shield-halved"></i>{{/if}} tick {{nextTick}}</span>
              {{#if statuses.length}}<span class="small statuses">{{#each statuses}}{{this}} {{/each}}</span>{{/if}}
            </div>
            <button type="button" class="inline-control icon fa-solid fa-right-left" data-action="swapRow" data-tooltip="Swap row"></button>
          </div>
          {{/each}}
        </div>
      </div>
      {{/each}}
    </div>
    {{/each}}
  </div>

  <footer class="queue">
    <span class="label">Next 10:</span>
    {{#each projection}}<span class="projected" data-tooltip="Tick {{tick}}">{{name}}</span>{{/each}}
  </footer>
  {{/unless}}
</div>
