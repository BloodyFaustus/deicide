<div class="class-tree-root">
  <aside class="profs">
    <h3>{{localize "DEICIDE.ClassTree.Proficiencies"}}</h3>
    <ul class="plain">
      {{#each proficiencies}}<li><span>{{label}}</span><strong>{{grade}}</strong></li>{{/each}}
    </ul>
    <p class="legend"><span class="swatch owned"></span> {{localize "DEICIDE.ClassTree.Owned"}} <span class="swatch ok"></span> {{localize "DEICIDE.ClassTree.Reachable"}} <span class="swatch locked"></span> {{localize "DEICIDE.ClassTree.Locked"}}</p>
  </aside>
  <div class="tiers">
    {{#each tiers}}
    <section class="tier">
      <h3>{{localize "DEICIDE.ClassTree.Tier" tier=tier}} <small>{{#if (eq tier 1)}}{{localize "DEICIDE.ClassTree.Level1"}}{{else}}{{#if (eq gate "story")}}{{localize "DEICIDE.ClassTree.StoryGate"}}{{else}}{{localize "DEICIDE.ClassTree.Level" level=gate}}{{/if}}{{/if}}</small></h3>
      {{#each classes}}
      <div class="class-card {{#if owned}}owned{{else}}{{#if ok}}ok{{else}}locked{{/if}}{{/if}} {{#if active}}active{{/if}}" data-class-id="{{id}}">
        <header>
          <strong data-action="openClass" data-class-id="{{id}}">{{name}}</strong>
          <span class="types">{{types}}</span>
        </header>
        <p class="growth">{{growth}}</p>
        <p class="trains">{{trains}}</p>
        {{#if prerequisiteText}}<p class="prereq">{{localize "DEICIDE.ClassTree.Needs" text=prerequisiteText}}</p>{{/if}}
        {{#if missing}}<p class="missing">{{localize "DEICIDE.ClassTree.Missing" text=missing}}</p>{{/if}}
        {{#if (and @root.actor ok)}}{{#unless owned}}<button type="button" data-action="addClass" data-class-id="{{id}}">{{localize "DEICIDE.ClassTree.Enter"}}</button>{{/unless}}{{/if}}
      </div>
      {{/each}}
    </section>
    {{/each}}
  </div>
</div>
