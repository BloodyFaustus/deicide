<nav class="combat-controls deicide-footer" data-tooltip-direction="UP">
  {{#if hasCombat}}
    {{#if combat.started}}
      {{#if (eq engine "war")}}
        {{#if user.isGM}}
          <button type="button" class="combat-control" data-action="previousTurn" data-tooltip="{{localize 'DEICIDE.Tracker.PreviousPhase'}}"><i class="fa-solid fa-backward-step"></i></button>
          {{#if pendingDecisions}}
            <button type="button" class="combat-control" data-action="resolveAll" data-tooltip="{{localize 'DEICIDE.Tracker.ResolveAll'}}"><i class="fa-solid fa-forward-fast"></i> {{localize "DEICIDE.Tracker.AutoResolve"}}</button>
            <button type="button" class="combat-control" data-action="replan" data-tooltip="{{localize 'DEICIDE.Tracker.Replan'}}"><i class="fa-solid fa-rotate"></i></button>
          {{/if}}
          <button type="button" class="combat-control" data-action="endPhase" data-tooltip="{{#if (eq phase 'enemy')}}{{localize 'DEICIDE.Tracker.EndRound'}}{{else}}{{localize 'DEICIDE.Tracker.EndLathander'}}{{/if}}"><i class="fa-solid fa-forward-step"></i> {{localize "DEICIDE.Tracker.EndPhase"}}</button>
          <button type="button" class="combat-control" data-action="endCombat" data-tooltip="{{localize 'DEICIDE.Tracker.EndCombat'}}"><i class="fa-solid fa-xmark"></i></button>
        {{else}}
          <span class="phase-note">{{#if (eq phase 'enemy')}}{{localize "DEICIDE.Tracker.EnemyPhase"}}{{else}}{{localize "DEICIDE.Tracker.LathanderPhase"}}{{/if}}</span>
        {{/if}}
      {{/if}}
      {{#if (eq engine "dungeon")}}
        {{#if user.isGM}}
          <button type="button" class="combat-control" data-action="previousTurn" data-tooltip="{{localize 'DEICIDE.Tracker.UndoAction'}}"><i class="fa-solid fa-backward-step"></i></button>
          <button type="button" class="combat-control" data-action="endAction" data-weight="6" data-tooltip="{{localize 'DEICIDE.Stage.W6'}}">W6</button>
          <button type="button" class="combat-control" data-action="endAction" data-weight="8" data-tooltip="{{localize 'DEICIDE.Stage.W8'}}">W8</button>
          <button type="button" class="combat-control" data-action="endAction" data-weight="12" data-tooltip="{{localize 'DEICIDE.Stage.W12'}}">W12</button>
          <button type="button" class="combat-control" data-action="endAction" data-weight="6" data-guard="true" data-tooltip="{{localize 'DEICIDE.Stage.Guard'}}"><i class="fa-solid fa-shield-halved"></i></button>
          <button type="button" class="combat-control" data-action="openStage" data-tooltip="{{localize 'DEICIDE.Tracker.OpenStage'}}"><i class="fa-solid fa-table-cells-large"></i></button>
          <button type="button" class="combat-control" data-action="endCombat" data-tooltip="{{localize 'DEICIDE.Tracker.EndCombat'}}"><i class="fa-solid fa-xmark"></i></button>
        {{else}}
          <button type="button" class="combat-control" data-action="openStage" data-tooltip="{{localize 'DEICIDE.Tracker.OpenStage'}}"><i class="fa-solid fa-table-cells-large"></i> {{localize "DEICIDE.Tracker.Stage"}}</button>
        {{/if}}
      {{/if}}
    {{else}}
      {{#if user.isGM}}
        <button type="button" class="combat-control combat-control-lg" data-action="startCombat"><i class="fa-solid fa-swords"></i> {{localize "DEICIDE.Tracker.Begin" engine=engineLabel}}</button>
      {{/if}}
    {{/if}}
  {{/if}}
</nav>
