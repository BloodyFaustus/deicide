<ol class="combat-tracker plain deicide-tracker {{engine}}">
  {{#unless started}}
    {{#each turns}}
      <li class="combatant {{css}}" data-combatant-id="{{id}}" data-action="activateCombatant">
        <img class="token-image" src="{{img}}" alt="{{name}}" loading="lazy">
        <div class="token-name"><strong class="name">{{name}}</strong></div>
      </li>
    {{/each}}
  {{/unless}}

  {{#if started}}
  {{#if (eq engine "war")}}
    <li class="phase-banner {{phase}}">
      <strong>{{localize "DEICIDE.Tracker.Round" round=@root.combat.round}}</strong> <span class="phase-label">{{phaseLabel}}</span>
    </li>
    {{#each groups as |group side|}}
      <li class="side-header side-{{side}}">{{#if (eq side "party")}}{{localize "DEICIDE.Tracker.Lathander"}}{{else}}{{localize "DEICIDE.Tracker.Enemy"}}{{/if}}</li>
      {{#each group}}
        <li class="combatant {{css}} {{#if acted}}acted{{/if}} {{#if canAct}}can-act{{/if}}" data-combatant-id="{{id}}" data-action="activateCombatant">
          <img class="token-image" src="{{img}}" alt="{{name}}" loading="lazy">
          <div class="token-name">
            <strong class="name">{{name}}</strong>
            <div class="combatant-controls">
              {{#if strength}}<span class="strength {{#if wavering}}wavering{{/if}}" data-tooltip="{{localize 'DEICIDE.Tracker.StrengthHint'}}">{{strength}} ({{quality}})</span>{{/if}}
              {{#if activations}}<span class="activations" data-tooltip="{{localize 'DEICIDE.Tracker.ActivationsHint'}}">+{{activations}}</span>{{/if}}
              {{#if mine}}
              <button type="button" class="inline-control combatant-control icon fa-solid {{#if acted}}fa-rotate-left{{else}}fa-check{{/if}}" data-action="toggleActed" data-tooltip="{{#if acted}}{{localize 'DEICIDE.Tracker.UndoActed'}}{{else}}{{localize 'DEICIDE.Tracker.MarkActed'}}{{/if}}"></button>
              {{/if}}
              {{#if @root.user.isGM}}
              <button type="button" class="inline-control combatant-control icon fa-solid {{#if hidden}}fa-eye-slash{{else}}fa-eye{{/if}}" data-action="toggleHidden" data-tooltip="{{localize 'DEICIDE.Tracker.ToggleHidden'}}"></button>
              <button type="button" class="inline-control combatant-control icon fa-solid fa-skull" data-action="toggleDefeated" data-tooltip="{{localize 'DEICIDE.Tracker.ToggleDefeated'}}"></button>
              {{/if}}
            </div>
            {{#if effects.icons.length}}
            <div class="token-effects" data-tooltip="{{effects.tooltip}}">
              {{#each effects.icons}}<img class="token-effect" src="{{img}}" alt="{{name}}">{{/each}}
            </div>
            {{/if}}
          </div>
        </li>
      {{/each}}
    {{/each}}
    {{#if pendingDecisions}}
      <li class="side-header doctrine">{{localize "DEICIDE.Tracker.Doctrines" count=pendingDecisions}}</li>
      {{#each doctrineQueue}}
        {{#unless confirmed}}
        <li class="decision" data-company-id="{{companyId}}">
          <span class="text">{{effective}}{{#if move}}, {{localize "DEICIDE.Tracker.MoveTo" x=move.x y=move.y}}{{/if}}{{#if attack}}, {{localize "DEICIDE.Tracker.AttackAt" distance=attack.distance}}{{/if}}</span>
          {{#if @root.user.isGM}}<button type="button" class="inline-control icon fa-solid fa-play" data-action="resolveDecision" data-company-id="{{companyId}}" data-tooltip="{{localize 'DEICIDE.Tracker.Resolve'}}"></button>{{/if}}
        </li>
        {{/unless}}
      {{/each}}
    {{/if}}
  {{/if}}

  {{#if (eq engine "dungeon")}}
    <li class="phase-banner dungeon"><strong>{{localize "DEICIDE.Tracker.TickLine" tick=tick}}</strong></li>
    {{#each rows as |sideRows side|}}
      <li class="side-header side-{{side}}">{{#if (eq side "party")}}{{localize "DEICIDE.Tracker.Party"}}{{else}}{{localize "DEICIDE.Tracker.Enemy"}}{{/if}}</li>
      {{#each sideRows as |rowList row|}}
        <li class="row-header">{{localize (concat "DEICIDE.Stage.Row." row)}}</li>
        {{#each rowList}}
          <li class="combatant {{css}} {{#if current}}current{{/if}}" data-combatant-id="{{id}}" data-action="activateCombatant">
            <img class="token-image" src="{{img}}" alt="{{name}}" loading="lazy">
            <div class="token-name">
              <strong class="name">{{name}}</strong>
              <div class="combatant-controls">
                <span class="tick" data-tooltip="{{localize 'DEICIDE.Tracker.NextTick'}}">{{nextTick}}</span>
                {{#if guard}}<i class="fa-solid fa-shield-halved" data-tooltip="{{localize 'DEICIDE.Tracker.GuardHint'}}"></i>{{/if}}
                {{#if @root.user.isGM}}
                <button type="button" class="inline-control combatant-control icon fa-solid fa-right-left" data-action="swapRow" data-tooltip="{{localize 'DEICIDE.Tracker.SwapRow'}}"></button>
                <button type="button" class="inline-control combatant-control icon fa-solid fa-skull" data-action="toggleDefeated" data-tooltip="{{localize 'DEICIDE.Tracker.ToggleDefeated'}}"></button>
                {{/if}}
              </div>
              {{#if effects.icons.length}}
              <div class="token-effects" data-tooltip="{{effects.tooltip}}">
                {{#each effects.icons}}<img class="token-effect" src="{{img}}" alt="{{name}}">{{/each}}
              </div>
              {{/if}}
            </div>
          </li>
        {{/each}}
      {{/each}}
    {{/each}}
    <li class="side-header projection">{{localize "DEICIDE.Tracker.Next10"}}</li>
    <li class="projection-strip">
      {{#each projection}}<span class="projected" data-tooltip="{{localize 'DEICIDE.Tracker.TickHint' tick=tick}}">{{name}}</span>{{/each}}
    </li>
  {{/if}}
  {{/if}}
</ol>
