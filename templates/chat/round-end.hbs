<div class="deicide-card round-end">
  <h3>{{localize "DEICIDE.Card.RoundEnds" round=round}}</h3>
  <ul class="plain">
    {{#each log}}
      {{#if (eq kind "morale")}}
        <li><strong>{{name}}</strong>: {{localize "DEICIDE.Card.MoraleLine" roll=roll threshold=threshold}} {{#if passed}}{{localize "DEICIDE.Card.Holds"}}{{else}}{{localize "DEICIDE.Card.Routs"}}{{/if}}.</li>
      {{else}}
        <li><strong>{{name}}</strong>: {{statusId}}{{#if burn}} {{localize "DEICIDE.Card.DealsBurn" burn=burn}}{{/if}}{{#if ended}} {{localize "DEICIDE.Card.Ends"}}{{/if}}.</li>
      {{/if}}
    {{/each}}
  </ul>
</div>
